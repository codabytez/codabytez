# Copy to .env for local runs. .env is gitignored.
#
# A fine-grained personal access token with All Repositories access:
#   Account permissions:    read:Followers, read:Starring, read:Watching
#   Repository permissions: read:Commit statuses, read:Contents, read:Metadata,
#                           read:Issues, read:Pull Requests
#
# Or just borrow the GitHub CLI's token:  ACCESS_TOKEN=$(gh auth token) python today.py
ACCESS_TOKEN=

# Optional - defaults to config.USER_NAME
# USER_NAME=codabytez

# Optional - set to 1 to rebuild the line-of-code cache from scratch (slow)
# FORCE_CACHE=0

# Optional - the Music block on the card. Leave blank to omit it entirely.
# Mint the refresh token with:
#   python scripts/spotify_auth.py --client-id XXX --client-secret YYY
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
